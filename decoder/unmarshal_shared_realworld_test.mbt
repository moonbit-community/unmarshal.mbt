// Shared-reference tests using data generated by real OCaml 4.14.1
// (`Marshal.to_string`). These lock in the correct interpretation of
// CODE_SHARED* references as *backward distances* (OCaml runtime/intern.c:
// `intern_obj_table[obj_counter - ofs]`), not absolute forward indices.

///|
// ("a", s, "bb", s) with `let s = "ocaml"` -> 4th field shares the 2nd (ofs=2)
let rw_shared_string_quad_data : Bytes = [
  b'\x84', b'\x95', b'\xa6', b'\xbe', b'\x00', b'\x00', b'\x00', b'\x0e', b'\x00',
  b'\x00', b'\x00', b'\x04', b'\x00', b'\x00', b'\x00', b'\x0c', b'\x00', b'\x00',
  b'\x00', b'\x0b', b'\xc0', b'\x21', b'\x61', b'\x25', b'\x6f', b'\x63', b'\x61',
  b'\x6d', b'\x6c', b'\x22', b'\x62', b'\x62', b'\x04', b'\x02',
]

///|
// (inner, inner, inner) with `let inner = (7, 8)` -> two backward refs (ofs=1)
let rw_shared_tuple_triple_data : Bytes = [
  b'\x84', b'\x95', b'\xa6', b'\xbe', b'\x00', b'\x00', b'\x00', b'\x08', b'\x00',
  b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x07', b'\x00', b'\x00',
  b'\x00', b'\x07', b'\xb0', b'\xa0', b'\x47', b'\x48', b'\x04', b'\x01', b'\x04',
  b'\x01',
]

///|
// ("x", l, ("y", l)) with `let l = [1; 2; 3]` -> ref at distance 5
let rw_shared_list_after_data : Bytes = [
  b'\x84', b'\x95', b'\xa6', b'\xbe', b'\x00', b'\x00', b'\x00', b'\x0f', b'\x00',
  b'\x00', b'\x00', b'\x07', b'\x00', b'\x00', b'\x00', b'\x14', b'\x00', b'\x00',
  b'\x00', b'\x14', b'\xb0', b'\x21', b'\x78', b'\xa0', b'\x41', b'\xa0', b'\x42',
  b'\xa0', b'\x43', b'\x40', b'\xa0', b'\x21', b'\x79', b'\x04', b'\x05',
]

///|
test "rw shared string at backward distance 2" {
  let (_, value) = Decoder::new(rw_shared_string_quad_data).decode()
  // ("a", "ocaml", "bb", "ocaml") -- 4th element resolves to the shared "ocaml"
  inspect(
    value,
    content=(
      #|MBlock(
      #|  tag=0,
      #|  [
      #|    MString(<Bytes: [0x61]>),
      #|    MString(<Bytes: [0x6f, 0x63, 0x61, 0x6d, 0x6c]>),
      #|    MString(<Bytes: [0x62, 0x62]>),
      #|    MString(<Bytes: [0x6f, 0x63, 0x61, 0x6d, 0x6c]>),
      #|  ],
      #|)
    ),
  )
}

///|
test "rw shared tuple referenced twice" {
  let (_, value) = Decoder::new(rw_shared_tuple_triple_data).decode()
  // ((7,8), (7,8), (7,8)) -- both later fields are backward refs (ofs=1)
  inspect(
    value,
    content=(
      #|MBlock(
      #|  tag=0,
      #|  [
      #|    MBlock(tag=0, [MInt(7), MInt(8)]),
      #|    MBlock(tag=0, [MInt(7), MInt(8)]),
      #|    MBlock(tag=0, [MInt(7), MInt(8)]),
      #|  ],
      #|)
    ),
  )
}

///|
test "rw shared list at backward distance 5" {
  let (_, value) = Decoder::new(rw_shared_list_after_data).decode()
  // ("x", [1;2;3], ("y", [1;2;3])) -- nested ref resolves to the full list
  inspect(
    value,
    content=(
      #|MBlock(
      #|  tag=0,
      #|  [
      #|    MString(<Bytes: [0x78]>),
      #|    MBlock(
      #|      tag=0,
      #|      [MInt(1), MBlock(tag=0, [MInt(2), MBlock(tag=0, [MInt(3), MInt(0)])])],
      #|    ),
      #|    MBlock(
      #|      tag=0,
      #|      [
      #|        MString(<Bytes: [0x79]>),
      #|        MBlock(
      #|          tag=0,
      #|          [MInt(1), MBlock(tag=0, [MInt(2), MBlock(tag=0, [MInt(3), MInt(0)])])],
      #|        ),
      #|      ],
      #|    ),
      #|  ],
      #|)
    ),
  )
}

///|
// ("abc", [||], "abc") with `let s = "abc" in (s, [||], s)`.
// The empty array is an OCaml atom (byte 0x80): it is NOT registered in the
// object table (header num_objects = 2, not 3), so the 3rd field's shared
// reference (ofs=1) must resolve to "abc", not to the atom.
let rw_atom_between_shared_data : Bytes = [
  b'\x84', b'\x95', b'\xa6', b'\xbe', b'\x00', b'\x00', b'\x00', b'\x08', b'\x00',
  b'\x00', b'\x00', b'\x02', b'\x00', b'\x00', b'\x00', b'\x06', b'\x00', b'\x00',
  b'\x00', b'\x06', b'\xb0', b'\x23', b'\x61', b'\x62', b'\x63', b'\x80', b'\x04',
  b'\x01',
]

///|
test "rw atom is not registered for sharing" {
  let (_, value) = Decoder::new(rw_atom_between_shared_data).decode()
  // ("abc", [||], "abc") -- the 3rd field resolves past the atom to "abc"
  inspect(
    value,
    content=(
      #|MBlock(
      #|  tag=0,
      #|  [
      #|    MString(<Bytes: [0x61, 0x62, 0x63]>),
      #|    MBlock(tag=0, []),
      #|    MString(<Bytes: [0x61, 0x62, 0x63]>),
      #|  ],
      #|)
    ),
  )
}
